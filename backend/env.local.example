# IntelliClaim - Local Development Environment
# Copy this file to .env and fill in your actual API keys

# REQUIRED API Keys for Demo
# Get AIMLAPI_KEY from: https://aimlapi.com
AIMLAPI_KEY=your_aimlapi_key_here

# Get Google API Key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Environment
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Storage Directories (local)
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
FAISS_CACHE_DIR=./faiss_cache

# File Processing Limits
MAX_FILE_SIZE=52428800  # 50MB in bytes

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=openai/gpt-5-2025-08-07

# Processing Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_DOCUMENTS=5
SIMILARITY_THRESHOLD=0.7

# Security Settings (Local)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

